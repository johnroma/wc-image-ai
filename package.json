{
  "name": "wc-img-ai",
  "version": "0.5.1",
  "description": "Use AI to generate images for your img tags.",
  "author": {
    "name": "John Romani",
    "email": "john@anthood.com"
  },
  "keywords": [
    "web components",
    "ai",
    "image",
    "image ai"
  ],
  "homepage": "https://john.ro",
  "type": "module",
  "repository": "https://github.com/johnroma/wc-image-ai",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "files": [
    "dist",
    "types/ai-img.d.ts",
    "types/provider-ratios.d.ts",
    "types/server.d.ts",
    "types/get-generated-image.d.ts"
  ],
  "main": "./dist/wc-img-ai.js",
  "types": "./types/ai-img.d.ts",
  "exports": {
    ".": {
      "types": "./types/ai-img.d.ts",
      "default": "./dist/wc-img-ai.js"
    },
    "./provider-ratios": {
      "types": "./types/provider-ratios.d.ts",
      "default": "./dist/provider-ratios.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./dist/server.js"
    },
    "./types": "./types/ai-img.d.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "build:watch": "sh -c 'tsc --watch & tsc -p tsconfig.server.json --watch & vite build --watch'",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false && tsc -p tsconfig.server.json --noEmit --emitDeclarationOnly false",
    "lint": "pnpm lint:biome && pnpm lint:eslint",
    "lint:fix": "pnpm lint:biome:fix && pnpm lint:eslint:fix",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check --write .",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "preview": "vite preview",
    "demo": "node demo/server.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test": "pnpm build && MSW=true vitest run",
    "test:e2e": "pnpm build && MSW=true vitest run test/demo.e2e.test.ts",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.35.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.35.0",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^16.4.0",
    "msw": "^2.15.0",
    "nanoid": "^5.0.9",
    "typescript": "^5.2.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@lit-labs/observers": "^2.0.2",
    "@open-wc/lit-helpers": "^0.7.0",
    "@tanstack/ai": "0.41.0",
    "lit": "^3.1.0"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  }
}
