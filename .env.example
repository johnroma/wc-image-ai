# Copy to .env and fill in the provider key(s) used by the demo server.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override provider image models.
# OPENAI_IMAGE_MODEL=gpt-image-2
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Test-only, opt-in provider/upload mocks. Normal demo use must leave this off.
# The package test scripts set this automatically; uncomment only for test tooling.
# MSW=true
